{
  "name": "@propelx/proxy",
  "version": "0.1.0-dev",
  "private": true,
  "description": "PropelX Together.ai advisor proxy — server-side key custody (M11)",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
