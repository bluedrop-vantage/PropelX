PORT=4000
LANDING_ZONE_DIR=/path/to/landing-zone

NODE_ENV=development
JWT_SECRET=change-me

# Together.ai API Key — SERVER-SIDE ONLY. Never expose via VITE_ prefix.
TOGETHER_AI_API_KEY=

# Optional override; default is meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_MODEL=

PRODUCT_VERSION="1.0.0 | Release Date: YYYY-MM-DD | Build: 1.0.0-rc1"

# Whitelabel settings
WHITELABEL=BlueDrop, LLC
WL_PRODUCT="PropelX|scheme: {Propel|#FFFFFF}{X|#6AA94FFF}"
